{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "src/data/realestate/*.json",
          "src/data/schools_seoul.json",
          "src/data/korea-administrative-district.json",
          "src/data/realestate_regions.json",
          "src/data/lawd_code_map.json",
          "src/data/businesses.json",
          "src/data/users.json",
          "src/data/subscriptions.json",
          "src/data/analytics_events.json",
          "src/data/inquiries.json",
          "src/data/blog_posts.json",
          "config.json",
          "public/sitemap.xml"
        ],
        "excludeFiles": [
          "dist/**",
          "scratch/**",
          "docs/**",
          "*.txt",
          "src/data/realestate_seoul.json",
          "**/realestate_seoul.json"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/server.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/server.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/business",
      "destination": "/business.html"
    },
    {
      "source": "/business/",
      "destination": "/business.html"
    },
    {
      "source": "/partner",
      "destination": "/business.html"
    },
    {
      "source": "/partner/",
      "destination": "/business.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
